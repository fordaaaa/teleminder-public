# Teleminder configuration — copy to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
# NEVER commit .env. All values below are placeholders, not secrets.

# --- Telegram (from @BotFather and your own account) ---
# Bot token from BotFather, e.g. 123456789:AAExampleTokenReplaceMe
TELEGRAM_BOT_TOKEN=replace-me
# Your numeric Telegram USER ID. Personal mode derives the destination private
# chat and both allowlists from this ID; no separate chat/bot ID is needed.
# A numeric bot ID is not a credential: the BotFather TOKEN above is required.
TELEGRAM_USER_ID=123456789

# Additional private users, each with their own tasks, reminders and settings.
# Put their numeric Telegram user IDs here, separated by commas. They must /start
# the bot before it can send them reminders. Keep real IDs in your private .env.
TELEGRAM_PROFILE_USER_IDS=

# Optional advanced shared/group mode: omit TELEGRAM_USER_ID and configure
# TELEGRAM_CHAT_ID, ALLOWED_USER_IDS, ALLOWED_CHAT_IDS explicitly instead.
# Separate profiles require a single private owner and cannot use shared mode.

# --- Core ---
# IANA timezone used for display and calendar recurrence.
TIMEZONE=America/Toronto
# Inside the container this is /data/teleminder.db (named volume). Only change
# for local (non-Docker) runs.
DATABASE_PATH=/data/teleminder.db

# --- MCP endpoint ---
# Bearer token for the Streamable HTTP MCP endpoint. MUST be 32+ characters.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=replace-with-at-least-32-random-characters
# Bind inside the container. Keep 0.0.0.0 so Docker port publishing works;
# the host-side bind is restricted via BIND_ADDRESS below.
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Exact tailnet hostname(s) accepted by MCP DNS-rebinding protection. Localhost
# is always allowed. Set before connecting remotely, e.g.:
# MCP_ALLOWED_HOSTS=homelab.example.ts.net,homelab.example.ts.net:*
MCP_ALLOWED_HOSTS=
# Host-side bind for the published port. Loopback only — use Tailscale Serve
# for remote access. Do NOT set 0.0.0.0 here.
BIND_ADDRESS=127.0.0.1

# --- Digest schedule (initial defaults) ---
# Persisted schedule overrides these after first startup; change via /settings.
DIGEST_START_HOUR=9
DIGEST_END_HOUR=21
DIGEST_INTERVAL_MINUTES=60
QUIET_START_HOUR=22
QUIET_END_HOUR=9
SEND_EMPTY_DIGEST=false
